---
import 'toc-rail/style.css';
import '../styles/layouts/post.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Comments from '../components/Comments.astro';
import FeaturedPostGrid from '../components/FeaturedPostGrid.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ScrollFocus from '../components/ScrollFocus.astro';
import BaseLayout from './BaseLayout.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';
import { getUiText } from '../ui';
import { withPage } from '../utils/paths';
import { buildPersonJsonLd } from '../utils/seo';
import { serializeScriptJson } from '../utils/serialize-script-json';

type Props = CollectionEntry<'posts'>['data'] & {
  readingTime?: number;
  relatedPosts?: CollectionEntry<'posts'>[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readingTime,
  focusEffect,
  relatedPosts = [],
  demoURL,
  repoURL,
  category,
} = Astro.props;

const tr = getUiText();
const postsBase = withPage('/posts');
const heroImageWidths = [640, 960, 1280, 1600];
const heroImageSizes = '(max-width: 600px) calc(100vw - 32px), 784px';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteHref = new URL(withPage('/'), Astro.site).toString();
const pubDateISO = pubDate.toISOString();
const updatedDateISO = updatedDate?.toISOString();
const heroImageUrl = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;
const personJsonLd = buildPersonJsonLd(siteHref);

const jsonLd = serializeScriptJson({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: pubDateISO,
      dateModified: updatedDateISO ?? pubDateISO,
      url: canonicalURL.href,
      mainEntityOfPage: canonicalURL.href,
      inLanguage: SITE_LANG,
      ...(category && { articleSection: category }),
      ...(heroImageUrl && {
        image: {
          '@type': 'ImageObject',
          url: heroImageUrl,
          width: heroImage?.width,
          height: heroImage?.height,
        },
      }),
      author: { '@id': `${siteHref}#person` },
      publisher: { '@id': `${siteHref}#person` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: SITE_TITLE,
          item: siteHref,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: tr.postsTitle,
          item: new URL(postsBase, Astro.site).href,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: canonicalURL.href,
        },
      ],
    },
    personJsonLd,
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  section={category}
  bodyClass="post-page"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  </Fragment>

  {focusEffect && <ScrollFocus variant={focusEffect} />}

  <main id="main-content" class="post-main">
    <article data-pagefind-body>
      <header class="post-header">
        <div class="post-meta">
          <FormattedDate class="meta-date" date={pubDate} />
          {readingTime && (
            <>
              <span class="dot">·</span>
              <span class="meta-item">{tr.readingTime(readingTime)}</span>
            </>
          )}
          {updatedDate && (
            <>
              <span class="dot">·</span>
              <span class="meta-updated">
                {tr.updated} <FormattedDate date={updatedDate} />
              </span>
            </>
          )}
        </div>
        <h1 class="post-title" data-pagefind-meta="title">
          {title}
        </h1>
        {description && <p class="post-description">{description}</p>}
        {(demoURL || repoURL) && (
          <p class="post-links">
            {demoURL && (
              <a href={demoURL} target="_blank" rel="noopener">
                Live demo
              </a>
            )}
            {demoURL && repoURL && <span class="dot">·</span>}
            {repoURL && (
              <a href={repoURL} target="_blank" rel="noopener">
                Source
              </a>
            )}
          </p>
        )}
      </header>

      {heroImage && (
        <figure class="post-hero">
          {demoURL ? (
            <a href={demoURL} target="_blank" rel="noopener">
              <Image
                src={heroImage}
                alt={title}
                class="post-hero-img"
                widths={heroImageWidths}
                sizes={heroImageSizes}
                quality={88}
              />
            </a>
          ) : (
            <Image
              src={heroImage}
              alt={title}
              class="post-hero-img"
              widths={heroImageWidths}
              sizes={heroImageSizes}
              quality={88}
            />
          )}
        </figure>
      )}

      <div class="prose" id="prose-content">
        <slot />
      </div>

      {relatedPosts.length > 0 && (
        <section class="related-section" data-pagefind-ignore="all">
          <div class="related-header">
            <p class="related-label">{tr.relatedPosts}</p>
            <a href={postsBase} class="related-view-all">
              {tr.allPosts}
            </a>
          </div>
          <FeaturedPostGrid posts={relatedPosts} variant="related" />
        </section>
      )}
    </article>
    <Comments />
  </main>
  <ImageLightbox />

  <script>
    import { mountReadingRailLoader } from '../scripts/reading-rail-loader';

    mountReadingRailLoader();
  </script>
</BaseLayout>
