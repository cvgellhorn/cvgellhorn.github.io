{
  "name": "cvgellhorn",
  "description": "Christoph von Gellhorn — personal site, built with the Astro Tone theme.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Christoph von Gellhorn",
  "homepage": "https://cvgellhorn.com.au",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build && pagefind --site dist --glob \"{*.html,about/**/*.html,posts/**/*.html,search/**/*.html}\"",
    "preview": "astro preview --host",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,css,md,mdx}\"",
    "lint": "eslint \"src/**/*.{js,ts,astro}\" \"*.mjs\"",
    "lint:css": "stylelint \"src/**/*.{css,astro}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.4",
    "toc-rail": "^0.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "pagefind": "^1.5.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "@typescript-eslint/scope-manager": "8.70.0",
    "@typescript-eslint/types": "8.70.0",
    "@typescript-eslint/visitor-keys": "8.70.0",
    "yaml-language-server": {
      "yaml": "2.8.4"
    }
  }
}
