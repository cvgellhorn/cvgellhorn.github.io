---
import '../styles/pages/home.css';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import FeaturedPostGrid from '../components/FeaturedPostGrid.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getUiText } from '../ui';
import { withBase } from '../utils/paths';
const tr = getUiText();
const FEATURED_POST_COUNT = 3;

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredLead = posts.find((post) => post.data.homeFeatured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredLead?.id);
const pinnedRemainingPosts = remainingPosts
  .filter((post) => post.data.homeOrder)
  .sort((a, b) => {
    const orderDelta = (a.data.homeOrder ?? 0) - (b.data.homeOrder ?? 0);
    if (orderDelta !== 0) return orderDelta;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });
const fallbackRemainingPosts = remainingPosts.filter((post) => !post.data.homeOrder);
const orderedRemainingPosts = [...pinnedRemainingPosts, ...fallbackRemainingPosts];
const featuredPosts = (featuredLead ? [featuredLead, ...orderedRemainingPosts] : []).slice(
  0,
  FEATURED_POST_COUNT
);
const featuredIds = new Set(featuredPosts.map((post) => post.id));
const gridPosts = orderedRemainingPosts.filter((post) => !featuredIds.has(post.id)).slice(0, 3);
const featuredPlaceholderEntries = await Promise.all(
  featuredPosts.map(
    async (post) =>
      [
        post.id,
        post.data.heroImage
          ? (
              await getImage({
                src: post.data.heroImage,
                width: 88,
                height: 88,
                format: 'webp',
                quality: 32,
              })
            ).src
          : undefined,
      ] as const
  )
);
const featuredPlaceholderById = new Map<string, string | undefined>(featuredPlaceholderEntries);
const featuredPlaceholderStyle = (src: string | undefined) =>
  src ? `--tone-image-placeholder: url("${src}");` : undefined;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main id="main-content" class="home-main">
    <section class="hero">
      <h1 class="hero-title">
        <span class="hero-title-line">{tr.heroTitle}</span>
        {tr.heroTitleLine2 && (
          <span class="hero-title-line hero-title-line--accent">{tr.heroTitleLine2}</span>
        )}
      </h1>

      <p class="hero-desc">{SITE_DESCRIPTION}</p>

      <div class="hero-divider" aria-hidden="true"></div>

      <nav class="hero-recent" aria-label="All posts">
        <div class="hero-recent-list">
          <a href={withBase('/posts')} class="hero-recent-item">
            <span class="hero-recent-main">
              <span class="hero-recent-title">{tr.heroAllPosts}</span>
              <span class="hero-recent-arrow" aria-hidden="true">
                ↗
              </span>
            </span>
          </a>
        </div>
      </nav>
    </section>

    {featuredPosts.length > 0 && (
      <section class="featured-section" aria-label="Featured posts">
        {featuredPosts.map((post) => (
          <a href={withBase(`/posts/${post.id}/`)} class="featured-card">
            <div
              class="featured-thumb-wrap"
              style={featuredPlaceholderStyle(featuredPlaceholderById.get(post.id))}
            >
              {post.data.heroImage ? (
                <Image
                  src={post.data.heroImage}
                  alt=""
                  class="featured-thumb"
                  width={176}
                  height={176}
                  quality={80}
                  loading="lazy"
                />
              ) : (
                <div class="featured-thumb card-img-placeholder" />
              )}
            </div>
            <div class="featured-text">
              <p class="featured-meta">
                <FormattedDate date={post.data.pubDate} />
              </p>
              <h2 class="featured-title">{post.data.title}</h2>
              {post.data.description && <p class="featured-desc">{post.data.description}</p>}
              <span class="featured-cta">{tr.readLink}</span>
            </div>
          </a>
        ))}
      </section>
    )}

    {gridPosts.length > 0 && (
      <section class="posts-section">
        <div class="posts-header">
          <a href={withBase('/posts')} class="view-all">
            {tr.viewAll}
          </a>
        </div>
        <FeaturedPostGrid posts={gridPosts} />
      </section>
    )}
  </main>
</BaseLayout>
