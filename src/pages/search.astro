---
import '../styles/pages/search.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withPage } from '../utils/paths';
---

<BaseLayout
  title="Search"
  description="Search notes, Shopify posts, and projects."
  robots="noindex, follow"
>
  <main id="main-content" class="search-main">
    <div class="search-header">
      <h1 class="search-title">Search</h1>
    </div>
    <div id="search" class="search-ui" aria-busy="true">
      <p class="search-loading" role="status">
        Loading search...
      </p>
      <noscript>
        <style>
          .search-loading {
            display: none;
          }
        </style>
        <p class="search-fallback">
          Search needs JavaScript. Browse the <a href={withPage('/posts')}>posts archive</a>{' '}
          instead.
        </p>
      </noscript>
    </div>
  </main>

  <script>
    import { onReady } from '../scripts/mount';
    import { mountSearchPage } from '../scripts/search-page';

    onReady(mountSearchPage);
  </script>
</BaseLayout>
